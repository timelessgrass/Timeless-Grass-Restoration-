---
import { brand, area } from '../data/site';
import Icon from './Icon.astro';
import { SERVICE_ICON } from '../lib/icons';
import { SERVICES } from '../data/services';
import { ALL_PROBLEMS, HOWTOS, ALL_GUIDES, EXPLAINERS, CARE } from '../data/registry';
const core = SERVICES.filter((s) => s.tier === 'core');
const more = SERVICES.filter((s) => s.tier !== 'core');
---
<div class="topbar">
  <div class="wrap topbar__in">
    <span><svg class="ic ic--sm"><use href="#i-pin"/></svg><span class="topbar__long">Serving {area.name}: {area.line}</span><span class="topbar__short">Serving {area.name} · Free quotes</span></span>
    <span class="topbar__r">Owner-operated <i>·</i> Free quotes <i>·</i> <a href={brand.phoneHref} data-cta="call-topbar">{brand.phone}</a></span>
  </div>
</div>
<header class="hdr" data-hdr id="top">
  <div class="wrap hdr__in">
    <a class="hdr__logo" href="/"><img src="/assets/brand/logo-200.webp" srcset="/assets/brand/logo-200.webp 200w, /assets/brand/logo-400.webp 400w" sizes="77px" width="420" height="373" alt={brand.name}></a>
    <nav class="nav" aria-label="Main">
      <div class="nav__drop">
        <button class="nav__link" type="button" aria-expanded="false">Services<svg class="ic ic--sm"><use href="#i-chev"/></svg></button>
        <div class="mega">
          <div class="mega__col">
            <p class="mega__h">Cleaning &amp; odor</p>
            {core.map((s) => <a href={`/services/${s.slug}/`}><Icon name={SERVICE_ICON[s.slug] ?? 'sparkle'} /><span><b>{s.name}</b><small>{s.short}</small></span></a>)}
          </div>
          <div class="mega__col">
            <p class="mega__h">Repair &amp; restoration</p>
            {more.map((s) => <a href={`/services/${s.slug}/`}><Icon name={SERVICE_ICON[s.slug] ?? 'sparkle'} /><span><b>{s.name}</b><small>{s.short}</small></span></a>)}
            <a href="/services/"><b>All services</b><small>What we do, and what we don't</small></a>
          </div>
          <div class="mega__promo">
            <p class="mega__promo-h">Not sure what your turf needs?</p>
            <p>Start with the problem. We'll point you to the right fix.</p>
            <a class="btn btn--green btn--sm" href="/turf-problems/">Turf problems, solved</a>
            <a class="mega__tel" href={brand.phoneHref} data-cta="call-mega">or call {brand.phone}</a>
          </div>
        </div>
      </div>
      <a class="nav__link" href="/putting-greens/">Putting Greens</a>
      <a class="nav__link" href="/pricing/">Pricing</a>
      <div class="nav__drop">
        <button class="nav__link" type="button" aria-expanded="false">Learn<svg class="ic ic--sm"><use href="#i-chev"/></svg></button>
        <div class="mega mega--learn">
          <div class="mega__col"><p class="mega__h">Turf problems</p>{ALL_PROBLEMS.filter((p) => p.footer).slice(0, 5).map((p) => <a href={`/turf-problems/${p.slug}/`}>{p.short}</a>)}<a href="/turf-problems/"><b>All problems</b></a></div>
          <div class="mega__col"><p class="mega__h">How-to</p>{HOWTOS.slice(0, 5).map((h) => <a href={`/how-to/${h.slug}/`}>{h.short}</a>)}<a href="/how-to/"><b>All how-tos</b></a></div>
          <div class="mega__col"><p class="mega__h">Guides &amp; more</p><a href="/guides/">Guides &amp; comparisons</a><a href="/cost/">What it costs</a><a href="/turf-care/">Care by turf type</a><a href="/turf-101/">Turf 101</a><a href="/commercial/">For businesses</a><a href="/neighborhoods/">Neighborhood guides</a></div>
        </div>
      </div>
      <a class="nav__link" href="/service-areas/">Areas</a>
      <a class="nav__link" href="/commercial/">Commercial</a>
      <a class="nav__link" href="/about/">About</a>
    </nav>
    <div class="search" data-search>
      <label class="search__lbl"><span class="sr">Search the site</span><input class="search__in" type="search" placeholder="Search turf problems, how-tos…" autocomplete="off" data-search-in></label>
      <div class="search__res" data-search-res hidden></div>
    </div>
    <div class="hdr__cta">
      <a class="hdr__phone" href={brand.phoneHref} data-cta="call-header"><svg class="ic"><use href="#i-phone"/></svg>{brand.phone}</a>
      <a class="btn btn--green" href="/quote/" data-cta="quote-header">Get My Free Quote<svg class="ic"><use href="#i-arrow"/></svg></a>
    </div>
    <button class="hdr__burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="drawer"><span></span></button>
  </div>
  <div class="drawer" id="drawer" hidden>
    <nav class="wrap drawer__nav" aria-label="Mobile">
      <div class="search search--drawer" data-search><label class="search__lbl"><span class="sr">Search the site</span><input class="search__in" type="search" placeholder="Search turf problems, how-tos…" autocomplete="off" data-search-in></label><div class="search__res" data-search-res hidden></div></div>
      <a href="/services/">Services</a>
      <a href="/putting-greens/">Putting greens</a>
      <a href="/pricing/">Pricing</a>
      <a href="/turf-problems/">Turf problems</a>
      <a href="/how-to/">How-to</a>
      <a href="/guides/">Guides</a>
      <a href="/cost/">Costs</a>
      <a href="/turf-care/">Care by turf type</a>
      <a href="/turf-101/">Turf 101</a>
      <a href="/service-areas/">Service areas</a>
      <a href="/neighborhoods/">Neighborhood guides</a>
      <a href="/commercial/">For businesses</a>
      <a href="/about/">About Brian</a>
      <a class="btn btn--green btn--lg" href="/quote/" data-cta="quote-drawer">Get My Free Quote</a>
      <a class="btn btn--ghost btn--lg" href={brand.phoneHref} data-cta="call-drawer"><svg class="ic"><use href="#i-phone"/></svg>Call {brand.phone}</a>
    </nav>
  </div>
</header>
