---
/** One icon from the sprite in Icons.astro. Decorative by default; pass `label` when it carries meaning. */
interface Props { name: string; class?: string; label?: string }
const { name, class: cls, label } = Astro.props;
---
<svg class:list={['ic', cls]} aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label}><use href={`#i-${name}`} /></svg>
