---
import Base from '../layouts/Base.astro';
import SubHero from '../components/SubHero.astro';
import AnswerBox from '../components/AnswerBox.astro';
import CtaBand from '../components/CtaBand.astro';
import IconStats from '../components/IconStats.astro';
import Steps from '../components/Steps.astro';
import Sidebar from '../components/Sidebar.astro';
import CtaStrip from '../components/CtaStrip.astro';
import { brand, area, SITE_URL } from '../data/site';
const crumbs = [{ name: 'Home', item: '/' }, { name: 'About', item: '/about/' }];
const q = `Who is behind ${brand.name}?`;
const a = `${brand.name} is owner-operated by ${brand.owner}, who has worked in artificial turf for ${brand.ownerYears} years, building and caring for lawns and putting greens. The restoration company was started in ${brand.founded} to clean, treat and restore turf that is already in the ground across ${area.name}. New turf is installed by his sister company, ${brand.sister.name}. Call ${brand.phone} to talk to him directly.`;
const schema = [{ '@type': 'Person', '@id': `${SITE_URL}/about/#brian`, name: brand.owner, jobTitle: 'Owner', worksFor: { '@id': `${SITE_URL}/#business` }, knowsAbout: ['Artificial turf', 'Synthetic putting greens', 'Turf cleaning and restoration'] }];
---
<Base title={`About Brian | ${brand.name}`} description={`Brian has 13 years in artificial turf and putting greens. Why a turf builder started a turf cleaning company on the Grand Strand, and what blown clean means.`} crumbs={crumbs} answer={{ question: q, answer: a }} schema={schema}>
  <SubHero kicker="About" h1="Hi, I'm Brian." lede="I've spent thirteen years building and looking after artificial turf and putting greens. Most of the turf I was asked to replace just needed cleaning properly, so that is what this company does." crumbs={crumbs} image={{ src: '/assets/img/putting-green-fire-pit-stone-wall.jpg', alt: 'A putting green Brian built, beside a fire pit and stone wall' }} cta />

  <IconStats light label="About Brian" items={[
    { icon: 'flag', value: String(brand.ownerYears), count: brand.ownerYears, suffix: '+', label: 'years building turf and putting greens' },
    { icon: 'ruler', value: 'By sq ft', label: 'priced up front, never by the hour' },
    { icon: 'sparkle', value: 'Blown clean', label: 'the finish on every job' },
    { icon: 'map', value: 'Grand Strand', label: 'Shallotte, NC to Burgess, SC' },
  ]} />

  <section class="sec sec--flush">
    <div class="wrap article">
      <article class="prose">
        <AnswerBox question={q} answer={a} />
        <h2>Why a builder cleans turf</h2>
        <p>After enough installs you stop seeing grass and start seeing the system: base, backing, seams, infill and drainage. Most "tired" turf has nothing wrong with any of it. It has pollen in the infill, a corner the dog uses and paths nobody has brushed. That is a few hundred dollars of proper work, not new turf.</p>
        <h2>The standard: blown clean</h2>
        <p>My test of a turf job is whether you can blow off the green when it is finished. Every leaf and needle off, fringe cleared, cups cleaned, surface groomed. Every job ends with the turf, the borders and the patio blown clean.</p>
        <CtaStrip title="Want it done to that standard?" text="Free quote by square foot, before any work starts." icon="sparkle" />
        <h2>What we do and don't do</h2>
        <p>We clean, treat and restore turf that is already installed: <a href="/services/">every service is here</a>. We don't install. When turf is past saving, I say so and hand it to my other company, <a href={brand.sister.url} rel="noopener">{brand.sister.name}</a>, so this company never has a reason to sell you a replacement.</p>
      </article>
      <Sidebar title={`Talk to ${brand.owner}`} />
    </div>
  </section>

  <section class="sec sec--cream">
    <div class="wrap">
      <div class="sec__head center" data-reveal><p class="kicker">How a job goes</p><h2>Four steps, no surprises</h2></div>
      <Steps steps={[
        { icon: 'phone', title: 'You call or send the form', text: 'I follow up to ask about size, pets and what is bothering you.' },
        { icon: 'tag', title: 'You get a price', text: 'By square foot, before anyone comes out. Add-ons are quoted after I see the yard, and you decide.' },
        { icon: 'camera', title: 'We do the work', text: 'Usually one visit. A Premium Restoration comes with before and after photos.' },
        { icon: 'sparkle', title: 'It ends blown clean', text: 'I walk it with you if you are home.' },
      ]} />
    </div>
  </section>
  <CtaBand />
</Base>
