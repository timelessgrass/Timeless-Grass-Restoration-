---
/** The sticky quote card. Related links render under the article (MoreLinks) so this always fits a laptop screen. */
import Icon from './Icon.astro';
import { brand } from '../data/site';
interface Props { priceLine?: string; priceLabel?: string; plan?: string; title?: string; links?: unknown }
const { priceLine, priceLabel = 'Pricing', plan, title = 'Get an upfront price' } = Astro.props;
const href = plan ? `/quote/?plan=${encodeURIComponent(plan)}` : '/quote/';
---
<aside class="side" aria-label="Get a quote">
  <div class="side__sticky">
    <div class="side__card side__card--cta">
      <h3>{title}</h3>
      {priceLine && <p class:list={['side__price', { 'side__price--long': priceLine.length > 30 }]}><small>{priceLabel}</small>{priceLine}</p>}
      <ul class="side__ticks">
        <li><Icon name="ruler" />Priced by square foot</li>
        <li><Icon name="tag" />Price before any work starts</li>
        <li><Icon name="sparkle" />Every job ends blown clean</li>
      </ul>
      <a class="btn btn--green" href={href} data-cta="quote-side">Get My Free Quote<Icon name="arrow" /></a>
      <a class="btn btn--outline-light" href={brand.phoneHref} data-cta="call-side"><Icon name="phone" />{brand.phone}</a>
    </div>
  </div>
</aside>
