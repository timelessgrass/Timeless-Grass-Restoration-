---
import { clip } from '../../lib/text';
import ArticleLayout from '../../components/ArticleLayout.astro';
import { CLUSTERS } from '../../data/problems';
import { ALL_PROBLEMS, findProblem, findService, HOWTOS } from '../../data/registry';
import { brand } from '../../data/site';
import type { Article } from '../../data/types';
export function getStaticPaths() { return ALL_PROBLEMS.map((p) => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props;
const svc = findService(p.service)!;
const related = p.related.map(findProblem).filter(Boolean);
const howtos = HOWTOS.filter((h) => (h.problems ?? []).includes(p.slug)).slice(0, 4);
const a: Article = { slug: p.slug, short: p.short, title: p.title, description: p.description, h1: p.h1, lede: p.lede, question: p.question, answer: p.answer, image: p.image, sections: p.sections, faq: p.faq, updated: '2026-09-12',
  diagram: p.cluster === 'odor' ? 'odor' : p.slug === 'black-patches-algae-on-artificial-grass' ? 'shade' : p.slug === 'putting-green-rolls-slow-or-bumpy' ? 'green' : p.slug === 'water-pooling-on-artificial-turf' ? 'cross-section' : undefined };
const crumbs = [{ name: 'Home', item: '/' }, { name: 'Turf problems', item: '/turf-problems/' }, { name: p.short, item: `/turf-problems/${p.slug}/` }];
---
<ArticleLayout a={a} kicker={CLUSTERS[p.cluster]} crumbs={crumbs} description={p.description} priceLine={svc.priceLine} priceLabel={svc.name} plan={svc.plan === 'premium' ? 'Premium Restoration' : svc.plan === 'essential' ? 'Essential Clean' : undefined}
  sideLinks={[
    { h: 'The service that fixes it', items: [{ href: `/services/${svc.slug}/`, label: svc.name }, ...svc.related.map((r) => findService(r)!).map((r) => ({ href: `/services/${r.slug}/`, label: r.name }))] },
    { h: 'Do it yourself', items: howtos.map((h) => ({ href: `/how-to/${h.slug}/`, label: h.short })) },
    { h: 'Related problems', items: related.map((r) => ({ href: `/turf-problems/${r!.slug}/`, label: r!.short })) },
  ]}
  related={related.map((r) => ({ href: `/turf-problems/${r!.slug}/`, title: r!.h1, blurb: clip(r!.lede, 140), image: r!.image?.src }))}
  relatedH2="If you have this, you might also have…"
  callout={`<b>The fix:</b> <a href="/services/${svc.slug}/">${svc.name}</a>. ${svc.priceLine}. <a href="/quote/">Get a free quote</a> or call ${brand.phone}.`}
/>
