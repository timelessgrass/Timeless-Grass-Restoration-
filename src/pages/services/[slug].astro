---
import Base from '../../layouts/Base.astro';
import SubHero from '../../components/SubHero.astro';
import AnswerBox from '../../components/AnswerBox.astro';
import Sidebar from '../../components/Sidebar.astro';
import Faq from '../../components/Faq.astro';
import Related from '../../components/Related.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SERVICES, serviceBySlug } from '../../data/services';
import { PROBLEMS } from '../../data/problems';
import { TOWNS } from '../../data/towns';
import { brand, SITE_URL } from '../../data/site';

export function getStaticPaths() { return SERVICES.map((s) => ({ params: { slug: s.slug }, props: { s } })); }
const { s } = Astro.props;
const crumbs = [{ name: 'Home', item: '/' }, { name: 'Services', item: '/services/' }, { name: s.name, item: `/services/${s.slug}/` }];
const problems = s.problems.map((slug) => PROBLEMS.find((p) => p.slug === slug)).filter(Boolean);
const related = s.related.map((slug) => serviceBySlug(slug)).filter(Boolean);
const schema = [{
  '@type': 'Service', '@id': `${SITE_URL}/services/${s.slug}/#service`, name: s.name, serviceType: s.name, description: s.description,
  provider: { '@id': `${SITE_URL}/#business` }, areaServed: TOWNS.map((t) => ({ '@type': 'City', name: `${t.name}, ${t.state}` })),
}];
---
<Base title={s.title} description={s.description} crumbs={crumbs} answer={{ question: s.question, answer: s.answer }} faq={s.faq} schema={schema} ogImage={s.image.src}>
  <SubHero kicker={s.tier === 'core' ? 'Cleaning & odor' : 'Repair & restoration'} h1={s.h1} lede={s.lede} crumbs={crumbs} image={s.image}>
    <div class="btnrow"><a class="btn btn--green btn--lg" href="/quote/" data-cta="quote-hero">Get My Free Quote<svg class="ic"><use href="#i-arrow"/></svg></a><a class="btn btn--ghost btn--lg" href={brand.phoneHref} data-cta="call-hero"><svg class="ic"><use href="#i-phone"/></svg>{brand.phone}</a></div>
  </SubHero>
  <section class="sec">
    <div class="wrap article">
      <article class="prose">
        <AnswerBox question={s.question} answer={s.answer} />
        {s.sections.map((sec) => <><h2>{sec.h2}</h2><div set:html={sec.html} /></>)}
        <h2>What's included</h2>
        <ul class="checks">{s.included.map((i) => <li>{i}</li>)}</ul>
        <p>See the <a href="/pricing/">full price table</a> for every size band, or the <a href="/services/">services overview</a> for what we do and don't do.</p>
      </article>
      <Sidebar priceLine={s.priceLine} plan={s.plan === 'premium' ? 'Premium Restoration' : s.plan === 'essential' ? 'Essential Clean' : undefined} links={[
        { h: 'Problems this fixes', items: problems.map((p) => ({ href: `/turf-problems/${p!.slug}/`, label: p!.short })) },
        { h: 'Related services', items: related.map((r) => ({ href: `/services/${r!.slug}/`, label: r!.name })) },
        { h: 'Where we do it', items: TOWNS.slice(0, 6).map((t) => ({ href: `/service-areas/${t.slug}/`, label: `${t.name}, ${t.state}` })) },
      ]} />
    </div>
  </section>
  <Faq faq={s.faq} h2={`${s.name}: questions we get asked`} />
  <Related kicker="Start with the symptom" h2="Turf problems this service fixes" items={problems.map((p) => ({ href: `/turf-problems/${p!.slug}/`, title: p!.h1, blurb: p!.lede.slice(0, 140) + '…', image: p!.image?.src }))} />
  <CtaBand />
</Base>
