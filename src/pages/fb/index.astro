---
/* Follow-up page for Meta Instant Form leads. noindex; no site chrome (its own minimal header).
   Meta Pixel base code goes in the head slot below once Brian has the pixel ID; the follow-up
   form fires "Contact" on submit via data-fbq. Never fire "Lead" here (the Instant Form counts it). */
import Base from '../../layouts/Base.astro';
import PriceTable from '../../components/PriceTable.astro';
import Steps from '../../components/Steps.astro';
import ProofGallery from '../../components/ProofGallery.astro';
import Icon from '../../components/Icon.astro';
import { brand, pricing as P, money } from '../../data/site';
import { availableJobs } from '../../lib/jobs';
const sms = (body: string) => `${brand.smsHref}?&body=${encodeURIComponent(body)}`;
const photos = sms('Hi Brian! I just asked for a turf cleaning quote. Here are a few photos of my turf:');
const jobs = availableJobs();
const faq = [
  ['Is this going to be a pushy sales call?', `No. ${brand.owner} asks a few questions about your turf, gives you a price, and that's it.`],
  ['How much will it cost?', `It depends on size and condition. Pricing starts at ${money(P.rows[0].essential!)} for yards up to 500 sq ft, and the table above shows every size. You get your exact price before any work starts.`],
  ['Is it safe for my kids and dog?', 'Yes. We use turf-safe, pet-safe products, and your turf is ready to use as soon as it is dry.'],
  ['I missed the call. What now?', `Call or text ${brand.phone} anytime and we'll pick up where we left off.`],
  ['Where do you work?', 'From Shallotte, NC to Burgess, SC, along the coast and inland through Loris and Conway, including Myrtle Beach, North Myrtle Beach, Carolina Forest and Longs.'],
];
---
<Base title={`You're in! Here's what happens next | ${brand.name}`} description="Your turf cleaning quote request is in. Here's what happens next." robots="noindex, nofollow" chrome="minimal">

<header class="lp-bar">
  <div class="wrap lp-bar__in">
    <a href="/"><img src="/assets/brand/logo.webp" width="420" height="373" alt={brand.name}></a>
    <a class="lp-bar__tel" href={brand.phoneHref}><Icon name="phone" />{brand.phone}</a>
  </div>
</header>

<section class="hero lp-hero">
  <div class="wrap lp-hero__in">
    <span class="okmark" aria-hidden="true"></span>
    <p class="kicker intro" style="--d:1">Request received</p>
    <h1 class="intro" style="--d:2">You're in<span data-name></span>! Here's what happens next.</h1>
    <p class="lead intro" style="--d:3">{brand.owner}, the owner, will call or text you from <b>{brand.phone}</b> within one business day.</p>
    <div class="phonecard intro" style="--d:4">
      <img src="/assets/brand/apple-touch-icon.png" width="180" height="180" alt="">
      <div><small>Calls &amp; texts come from</small><b>{brand.phone}</b><span>{brand.owner} · {brand.name}</span></div>
      <a class="btn btn--ghost btn--sm" href="/assets/timeless-contact.vcf"><Icon name="save" />Save</a>
    </div>
    <p class="lp-hint">Save the number so you know it's us when we call.</p>
    <div class="btnrow btnrow--center" data-hero-cta>
      <a class="btn btn--green btn--lg" href="#faster">Get my price faster<Icon name="arrow" /></a>
      <a class="btn btn--ghost btn--lg" href={photos}><Icon name="chat" />Text us photos</a>
    </div>
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <div class="sec__head center" data-reveal><p class="kicker">What happens next</p><h2>From request to clean turf</h2></div>
    <Steps steps={[
      { icon: 'phone', label: 'Within 1 business day', title: `${brand.owner} reaches out`, text: `A quick call or text from ${brand.phone} to learn about your turf.` },
      { icon: 'camera', label: 'Optional', title: 'You send a few photos', text: 'Two or three photos help get your price right the first time.' },
      { icon: 'tag', label: 'Before any work', title: 'You get an upfront price', text: 'By square footage, never by the hour. No surprise fees.' },
      { icon: 'sparkle', label: 'Most yards: one visit', title: 'We clean it, blown clean', text: 'Deep cleaned, groomed and ready once dry.' },
    ]} />
  </div>
</section>

<section class="sec sec--cream" id="faster">
  <div class="wrap lp-narrow">
    <div class="sec__head center" data-reveal><p class="kicker">Optional · 30 seconds</p><h2>Want your price faster?</h2><p>Tap a few answers and {brand.owner} will have your number ready when he calls.</p></div>
    <form class="form lp-form" name="fb-followup" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-fbq="Contact" data-reveal>
      <input type="hidden" name="form-name" value="fb-followup">
      <p class="hp"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
      <fieldset class="q">
        <legend>How big is your turf?</legend>
        <div class="chips-in">
          <label class="chip"><input type="radio" name="size" value="Under 500 sq ft" data-e="$199" data-p="$299"><span>Under 500 sq ft</span></label>
          <label class="chip"><input type="radio" name="size" value="500–1,000 sq ft" data-e="$249" data-p="$399"><span>500–1,000</span></label>
          <label class="chip"><input type="radio" name="size" value="1,000–2,000 sq ft" data-e="$299–$349" data-p="$499–$599"><span>1,000–2,000</span></label>
          <label class="chip"><input type="radio" name="size" value="2,000–5,000 sq ft" data-e="$449–$599" data-p="$749–$899"><span>2,000–5,000</span></label>
          <label class="chip"><input type="radio" name="size" value="Not sure"><span>Not sure</span></label>
        </div>
        <p class="ballpark" data-ballpark hidden></p>
      </fieldset>
      <fieldset class="q">
        <legend>Who uses it?</legend>
        <div class="chips-in">
          <label class="chip"><input type="radio" name="pets" value="No pets"><span>No pets</span></label>
          <label class="chip"><input type="radio" name="pets" value="1 dog"><span>1 dog</span></label>
          <label class="chip"><input type="radio" name="pets" value="2+ dogs"><span>2+ dogs</span></label>
          <label class="chip"><input type="radio" name="pets" value="Putting green"><span>It's a putting green</span></label>
        </div>
      </fieldset>
      <fieldset class="q">
        <legend>What bugs you most?</legend>
        <div class="chips-in">
          <label class="chip"><input type="radio" name="issue" value="Pet odor"><span>Pet odor</span></label>
          <label class="chip"><input type="radio" name="issue" value="Dirty or matted"><span>Dirty or matted</span></label>
          <label class="chip"><input type="radio" name="issue" value="Weeds and debris"><span>Weeds &amp; debris</span></label>
          <label class="chip"><input type="radio" name="issue" value="Slow or bumpy green"><span>Slow or bumpy green</span></label>
        </div>
      </fieldset>
      <fieldset class="q">
        <legend>Best time to reach you?</legend>
        <div class="chips-in">
          <label class="chip"><input type="radio" name="best_time" value="Morning"><span>Morning</span></label>
          <label class="chip"><input type="radio" name="best_time" value="Afternoon"><span>Afternoon</span></label>
          <label class="chip"><input type="radio" name="best_time" value="Evening"><span>Evening</span></label>
          <label class="chip"><input type="radio" name="best_time" value="Text me instead"><span>Text me instead</span></label>
        </div>
      </fieldset>
      <div class="field"><label for="lp-name">First name</label><input id="lp-name" name="name" autocomplete="given-name" data-name-input></div>
      <div class="field"><label for="lp-phone">Phone *</label><input id="lp-phone" name="phone" type="tel" autocomplete="tel" required></div>
      <button class="btn btn--green btn--lg" type="submit">Send to {brand.owner}<Icon name="arrow" /></button>
      <p class="form__msg form__msg--ok" role="status" hidden>Got it! {brand.owner} will have your price ready when he calls.</p>
      <p class="form__msg form__msg--err" role="alert" hidden>Something went wrong. Please call or text {brand.phone}.</p>
      <p class="form__fine">We only use your number to match this with your request.</p>
    </form>
  </div>
</section>

<section class="sec lp-work" aria-label="Recent work">
  <div class="wrap">
    <div class="sec__head" data-reveal><p class="kicker">{jobs.length ? 'Before & after' : 'Our work'}</p><h2>{jobs.length ? 'What one visit changes' : 'Lawns and greens, kept like new'}</h2></div>
    {jobs.length > 0 && <ProofGallery limit={3} />}
  </div>
  {jobs.length === 0 && <div class="strip">
    <img src="/assets/img/backyard-putting-green-from-the-street.jpg" width="1400" height="1050" alt="Backyard putting green seen from the street" loading="lazy" decoding="async">
    <img src="/assets/img/pet-turf-dog-resting-under-deck.jpg" width="1050" height="1400" alt="Dog resting on pet turf under a deck" loading="lazy" decoding="async">
    <img src="/assets/img/artificial-lawn-fenced-yard-rock-border.jpg" width="1050" height="1400" alt="Artificial lawn in a fenced yard with a rock border" loading="lazy" decoding="async">
    <img src="/assets/img/putting-green-fire-pit-stone-wall.jpg" width="1400" height="1050" alt="Putting green beside a fire pit and stone wall" loading="lazy" decoding="async">
    <img src="/assets/img/practice-nets-and-goals-on-turf.jpg" width="1050" height="1400" alt="Practice nets and goals on artificial turf" loading="lazy" decoding="async">
  </div>}
</section>

<section class="sec">
  <div class="wrap split">
    <figure class="photo" data-reveal="scale">
      <img src="/assets/img/putting-green-at-sunset-wide.jpg" width="1400" height="1050" alt="Putting green at sunset" loading="lazy" decoding="async">
      <figcaption><b>Blown clean.</b> The finish on every job.</figcaption>
    </figure>
    <div data-reveal>
      <p class="kicker">Who's calling you</p>
      <h2>Hi, I'm {brand.owner}.</h2>
      <p class="body">I've spent {brand.ownerYears} years building and caring for artificial turf and putting greens. I clean turf the way it was built: through the blades, backing and infill.</p>
      <p class="body">You get a clear price before any work starts, and I don't leave until it's blown clean.</p>
      <p class="sig">{brand.owner}, owner of {brand.name}</p>
    </div>
  </div>
</section>

<section class="sec sec--cream">
  <div class="wrap">
    <div class="sec__head center" data-reveal><p class="kicker">Upfront pricing</p><h2>No hourly rates. No surprises.</h2><p>Your exact price comes before any work starts.</p></div>
    <PriceTable />
    <p class="note">Want it kept clean all year? Memberships start at ${P.memberships[0].monthly}/month.</p>
  </div>
</section>

<section class="sec">
  <div class="wrap faq">
    <div class="sec__head center" data-reveal><p class="kicker">Before {brand.owner} calls</p><h2>Quick answers</h2></div>
    <div data-stagger>{faq.map(([q, a], i) => <details><summary><span class="n">{i + 1}</span>{q}</summary><p>{a}</p></details>)}</div>
  </div>
</section>

<section class="final">
  <img src="/assets/img/putting-green-landscape-lighting-at-dusk.jpg" width="1400" height="1050" alt="" loading="lazy" decoding="async">
  <div class="wrap" data-reveal>
    <p class="kicker">Questions before {brand.owner} calls?</p>
    <h2>Call or text anytime.</h2>
    <p>Send photos, ask about pricing, or pick a better time to talk.</p>
    <div class="btnrow btnrow--center">
      <a class="btn btn--green btn--lg" href={brand.phoneHref}><Icon name="phone" />Call {brand.phone}</a>
      <a class="btn btn--outline-light btn--lg" href={sms('Hi Brian! I just asked for a turf cleaning quote.')}><Icon name="chat" />Send a text</a>
    </div>
  </div>
</section>

<footer class="lp-foot">
  <div class="wrap"><p>© <span data-year>2026</span> {brand.name} · <a href={`mailto:${brand.email}`}>{brand.email}</a> · <a href="/">Visit our full site</a> · <a href="/privacy/">Privacy</a></p></div>
</footer>

<div class="mbar">
  <a class="btn btn--ghost" href={brand.phoneHref}><Icon name="phone" />Call</a>
  <a class="btn btn--green" href={photos}><Icon name="chat" />Text us photos</a>
</div>

</Base>
