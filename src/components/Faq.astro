---
import Icon from './Icon.astro';
import { brand } from '../data/site';
interface Props { faq: { q: string; a: string }[]; kicker?: string; h2?: string; intro?: string; more?: boolean }
const { faq, kicker = 'FAQs', h2 = 'Questions we get asked', intro, more = true } = Astro.props;
---
{faq.length > 0 && <section class="sec faq-sec" id="faq">
  <div class="wrap faq">
    <div class="sec__head center" data-reveal>
      <p class="kicker">{kicker}</p>
      <h2>{h2}</h2>
      {intro && <p>{intro}</p>}
    </div>
    <div data-stagger>
      {faq.map((f, i) => <details><summary><span class="n">{i + 1}</span>{f.q}</summary><div class="faq__a" set:html={f.a} /></details>)}
    </div>
    {more && <div class="faq__more" data-reveal>
      <div><b>Still have a question?</b><p>Ask {brand.owner}. You get a straight answer, and a price before any work starts.</p></div>
      <div class="btnrow">
        <a class="btn btn--green" href="/quote/" data-cta="quote-faq">Get My Free Quote<Icon name="arrow" /></a>
        <a class="btn btn--ghost" href={brand.phoneHref} data-cta="call-faq"><Icon name="phone" />{brand.phone}</a>
      </div>
    </div>}
  </div>
</section>}
