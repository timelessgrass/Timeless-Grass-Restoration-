0;padding:30px 34px 28px;\">\n<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#8ad132;\">New quote request</div>\n<div class=\"h1\" style=\"font-family:Arial,Helvetica,sans-serif;padding-top:8px;font-size:30px;line-height:1.15;font-weight:800;color:#ffffff;\">{{1.data.name}}</div>\n<div style=\"font-family:Arial,Helvetica,sans-serif;padding-top:8px;font-size:14px;color:#b7c7af;\">ZIP {{ifempty(1.data.zip; \"not given\")}} &nbsp;·&nbsp; {{formatDate(1.created_at; \"ddd, MMM D · h:mm A\"; \"America/New_York\")}}</div>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-top:16px;\"><tr><td style=\"font-family:Arial,Helvetica,sans-serif;padding:7px 14px;border:1px solid #33492a;border-radius:999px;background:#1b2b14;font-size:13px;font-weight:700;color:#dfe9d8;\">Wants: <span style=\"color:#8ad132;\">{{ifempty(1.data.plan; \"Not sure, recommend one\")}}</span></td></tr></table>\n</td></tr></table>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td class=\"px\" style=\"padding:24px 34px 4px;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr>\n<td width=\"50%\" style=\"padding-right:6px;\"><a href=\"tel:{{replace(ifempty(1.data.phone; \"\"); /[^0-9+]/g; emptystring)}}\" style=\"font-family:Arial,Helvetica,sans-serif;display:block;padding:15px 8px;border-radius:999px;background:#2e7a0b;font-size:15px;font-weight:800;color:#ffffff;text-align:center;text-decoration:none;\">Call {{first(split(trim(1.data.name); \" \"))}}</a></td>\n<td width=\"50%\" style=\"padding-left:6px;\"><a href=\"sms:{{replace(ifempty(1.data.phone; \"\"); /[^0-9+]/g; emptystring)}}?&amp;body=Hi%20{{encodeURL(first(split(trim(1.data.name); \" \")))}}%2C%20it's%20Brian%20with%20TIMELESS%20Turf%20Restoration.%20I%20got%20your%20request.%20Is%20now%20a%20good%20time%20to%20talk%3F\" style=\"font-family:Arial,Helvetica,sa