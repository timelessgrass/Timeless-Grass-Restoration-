---
import Base from '../../layouts/Base.astro';
import SubHero from '../../components/SubHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { COMMERCIAL, TIERS } from '../../data/registry';
import { brand } from '../../data/site';
const T = TIERS.commercial;
const crumbs = [{ name: 'Home', item: '/' }, { name: T.name, item: T.base }];
const kinds = [...new Set(COMMERCIAL.map((a) => a.kind).filter(Boolean))] as string[];
const groups = kinds.length > 1 ? kinds.map((k) => ({ k, items: COMMERCIAL.filter((a) => a.kind === k) })) : [{ k: '', items: COMMERCIAL }];
---
<Base title={`Commercial Turf Maintenance Programs | TIMELESS`} description={`Golf courses, mini golf, estates, vacation rentals, HOAs, resorts, dog daycares and schools: scheduled programs priced by square foot, with photos and reports.`} crumbs={crumbs}>
  <SubHero kicker={T.name} h1="Turf maintenance programs for businesses" lede="Golf courses, mini golf, estates, vacation rentals, HOAs, resorts, dog daycares and schools: scheduled programs priced by square foot, with photos and reports." crumbs={crumbs} />
  {groups.map((g) => <section class="sec sec--tight"><div class="wrap">{g.k && <div class="sec__head" data-reveal><h2>{g.k.charAt(0).toUpperCase() + g.k.slice(1)}</h2></div>}<div class="index">{g.items.map((a) => <a class="index__item" href={`${T.base}${a.slug}/`} data-reveal><small>{a.short}</small><h3>{a.h1}</h3><p>{a.answer.split('. ')[0]}.</p></a>)}</div></div></section>)}
  <CtaBand />
</Base>
