---
import Base from '../../layouts/Base.astro';
import SubHero from '../../components/SubHero.astro';
import AnswerBox from '../../components/AnswerBox.astro';
import CtaBand from '../../components/CtaBand.astro';
import CtaStrip from '../../components/CtaStrip.astro';
import Steps from '../../components/Steps.astro';
import Icon from '../../components/Icon.astro';
import { SERVICES } from '../../data/services';
import { brand, area, pricing as P, money } from '../../data/site';
import { SERVICE_ICON } from '../../lib/icons';
const crumbs = [{ name: 'Home', item: '/' }, { name: 'Services', item: '/services/' }];
const q = 'What does TIMELESS Turf Restoration do?';
const a = `TIMELESS Turf Restoration cleans, treats and restores existing artificial turf and synthetic putting greens on ${area.name}: deep cleaning, pet odor removal, antimicrobial sanitizing, algae and mold removal, hard-water and stain removal, power brushing, infill replenishment, putting green restoration, seam and edge repair, and post-storm cleanup. We do not install new turf; our sister company does.`;
const groups = [
  { k: 'Cleaning & odor', h: 'Clean, deodorize, sanitize', items: SERVICES.filter((s) => s.tier === 'core') },
  { k: 'Repair & restoration', h: 'When cleaning isn’t enough', items: SERVICES.filter((s) => s.tier !== 'core') },
];
---
<Base title="Turf Cleaning & Restoration Services | TIMELESS" description={`Every turf cleaning and restoration service we offer on the Grand Strand, what each fixes, and what it costs. From $199. We restore turf; we don't install it.`} crumbs={crumbs} answer={{ question: q, answer: a }}>
  <SubHero kicker="Services" h1="Turf cleaning &amp; restoration services" lede="Clean, treat and restore the turf and putting greens you already have. Priced by square foot, finished blown clean." crumbs={crumbs} cta
    trust={[{ icon: 'tag', label: `From ${money(P.rows[0].essential!)}` }, { icon: 'ruler', label: 'Priced by square foot' }, { icon: 'sparkle', label: 'Blown-clean finish' }]} />
  {groups.map((g, gi) => (
    <section class:list={['sec', { 'sec--flush': gi > 0 }]}>
      <div class="wrap">
        <div class="sec__head" data-reveal><p class="kicker">{g.k}</p><h2>{g.h}</h2></div>
        <div class="svc-grid" data-stagger>
          {g.items.map((s) => <a class="svc-card" href={`/services/${s.slug}/`}><span class="svc-card__ic"><Icon name={SERVICE_ICON[s.slug] ?? 'sparkle'} /></span><h3>{s.name}</h3><p>{s.short}</p><span class="price-chip"><Icon name="tag" />{s.priceLine.split(' · ')[0]}</span><Icon name="arrow" class="svc-card__go" /></a>)}
        </div>
      </div>
    </section>
  ))}
  <section class="sec sec--cream">
    <div class="wrap">
      <div class="sec__head center" data-reveal><p class="kicker">How it works</p><h2>From a quick quote to blown clean</h2></div>
      <Steps steps={[
        { icon: 'quote', title: 'Tell us about your turf', text: 'Send details or photos. You get a price by square foot before any work starts.' },
        { icon: 'search', title: 'Inspect and diagnose', text: 'Odor sources, drainage, infill depth, seams and blade wear, checked first.' },
        { icon: 'sparkle', title: 'Clean, treat, restore', text: 'The service your turf needs, nothing it does not.' },
        { icon: 'flag', title: 'Blown clean', text: 'Every job ends blown clean.' },
      ]} />
      <CtaStrip title="Not sure which service you need?" text={`Describe the problem or text photos. ${brand.owner} will tell you what fixes it and what it costs.`} icon="question" light />
    </div>
  </section>
  <section class="sec sec--tight"><div class="wrap" style="max-width:880px" data-reveal><AnswerBox question={q} answer={a} /></div></section>
  <section class="sec">
    <div class="wrap prose" data-reveal>
      <h2>What we don't do</h2>
      <p>We don't install new turf or build greens. When turf is past restoring, we say so and hand you to our sister company, <a href={brand.sister.url} rel="noopener">{brand.sister.name}</a>, run by the same owner. Our guide on <a href="/guides/clean-or-replace-artificial-turf/">clean or replace</a> shows how we tell.</p>
    </div>
  </section>
  <CtaBand />
</Base>
