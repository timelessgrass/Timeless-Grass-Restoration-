---
/* Follow-up page for Meta Instant Form leads. noindex; no site chrome (its own minimal header).
   Meta Pixel base code goes in the head slot below once Brian has the pixel ID; the follow-up
   form fires "Contact" on submit via data-fbq. Never fire "Lead" here (the Instant Form counts it). */
import Base from '../../layouts/Base.astro';
import { brand } from '../../data/site';
---
<Base title={`You're in! Here's what happens next | ${brand.name}`} description="Your turf cleaning quote request is in. Here's what happens next." robots="noindex, nofollow" chrome="minimal">


<header class="lp-bar">
  <div class="wrap lp-bar__in">
    <a href="/"><img src="/assets/brand/logo.png" width="480" height="362" alt="TIMELESS Turf Restoration"></a>
    <a class="lp-bar__tel" href="tel:+13033492368"><svg class="ic"><use href="#i-phone"/></svg>303-349-2368</a>
  </div>
</header>



<section class="hero lp-hero">
  <div class="wrap lp-hero__in">
    <span class="okmark" aria-hidden="true"></span>
    <p class="kicker">Request received</p>
    <h1>You're in<span data-name></span>! Here's what happens next.</h1>
    <p class="lead">Thanks for asking about a turf cleaning quote. Brian, the owner, will call or text you from <b>303-349-2368</b> within one business day.</p>
    <div class="phonecard">
      <img src="/assets/brand/apple-touch-icon.png" width="180" height="180" alt="">
      <div><small>Calls &amp; texts come from</small><b>303-349-2368</b><span>Brian · TIMELESS Turf Restoration</span></div>
      <a class="btn btn--ghost btn--sm" href="/assets/timeless-contact.vcf"><svg class="ic"><use href="#i-save"/></svg>Save</a>
    </div>
    <p class="lp-hint">Save the number so you know it's us when we call.</p>
    <div class="btnrow btnrow--center">
      <a class="btn btn--green btn--lg" href="#faster">Get my price faster<svg class="ic"><use href="#i-arrow"/></svg></a>
      <a class="btn btn--ghost btn--lg" href="sms:+13033492368?&amp;body=Hi%20Brian!%20I%20just%20asked%20for%20a%20turf%20cleaning%20quote.%20Here%20are%20a%20few%20photos%20of%20my%20turf%3A"><svg class="ic"><use href="#i-chat"/></svg>Text us photos</a>
    </div>
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <div class="sec__head center" data-reveal>
      <p class="kicker">What happens next</p>
      <h2>From request to clean turf</h2>
    </div>
    <ol class="proc">
      <li class="step" data-reveal><div class="step__n"><b>1</b><span>Within 1 business day</span></div><h3>Brian reaches out</h3><p>A quick call or text from 303-349-2368 to learn about your turf.</p></li>
      <li class="step" data-reveal><div class="step__n"><b>2</b><span>Optional</span></div><h3>You send a few photos</h3><p>Two or three photos help us get your price right the first time.</p></li>
      <li class="step" data-reveal><div class="step__n"><b>3</b><span>Before any work</span></div><h3>You get an upfront price</h3><p>Priced by square footage, never by the hour. No pressure and no surprise fees.</p></li>
      <li class="step" data-reveal><div class="step__n"><b>4</b><span>Most yards: one visit</span></div><h3>We clean it, blown clean</h3><p>Deep cleaned, groomed and ready to use as soon as it's dry.</p></li>
    </ol>
  </div>
</section>

<section class="sec sec--cream" id="faster">
  <div class="wrap lp-narrow">
    <div class="sec__head center" data-reveal>
      <p class="kicker">Optional · 30 seconds</p>
      <h2>Want your price faster?</h2>
      <p>Tap a few answers and Brian will have your number ready when he calls.</p>
    </div>
    <form class="form lp-form" name="fb-followup" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-fbq="Contact" data-reveal>
      <input type="hidden" name="form-name" value="fb-followup">
      <p class="hp"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
      <fieldset class="q">
        <legend>How big is your turf?</legend>
        <div class="chips-in">
          <label class="chip"><input type="radio" name="size" value="Under 500 sq ft" data-e="$199" data-p="$299"><span>Under 500 sq ft</span></label>
          <label class="chip"><input type="radio" name="size" value="500–1,000 sq ft" data-e="$249" data-p="$399"><span>500–1,000</span></label>
          <label class="chip"><input type="radio" name="size" value="1,000–2,000 sq ft" data-e="$299–$349" data-p="$499–$599"><span>1,000–2,000</span></label>
          <label class="chip"><input type="radio" name="size" value="2,000–5,000 sq ft" data-e="$449–$599" data-p="$749–$899"><span>2,000–5,000</span></label>
          <label class="chip"><input type="radio" name="size" value="Not sure"><span>Not sure</span></label>
        </div>
        <p class="ballpark" data-ballpark hidden></p>
      </fieldset>
      <fieldset class="q">
        <legend>Who uses it?</legend>
        <div class="chips-in">
          <label class="chip"><input type="radio" name="pets" value="No pets"><span>No pets</span></label>
          <label class="chip"><input type="radio" name="pets" value="1 dog"><span>1 dog</span></label>
          <label class="chip"><input type="radio" name="pets" value="2+ dogs"><span>2+ dogs</span></label>
          <label class="chip"><input type="radio" name="pets" value="Putting green"><span>It's a putting green</span></label>
        </div>
      </fieldset>
      <fieldset class="q">
        <legend>What bugs you most?</legend>
        <div class="chips-in">
          <label class="chip"><input type="radio" name="issue" value="Pet odor"><span>Pet odor</span></label>
          <label class="chip"><input type="radio" name="issue" value="Dirty or matted"><span>Dirty or matted</span></label>
          <label class="chip"><input type="radio" name="issue" value="Weeds and debris"><span>Weeds &amp; debris</span></label>
          <label class="chip"><input type="radio" name="issue" value="Slow or bumpy green"><span>Slow or bumpy green</span></label>
        </div>
      </fieldset>
      <fieldset class="q">
        <legend>Best time to reach you?</legend>
        <div class="chips-in">
          <label class="chip"><input type="radio" name="best_time" value="Morning"><span>Morning</span></label>
          <label class="chip"><input type="radio" name="best_time" value="Afternoon"><span>Afternoon</span></label>
          <label class="chip"><input type="radio" name="best_time" value="Evening"><span>Evening</span></label>
          <label class="chip"><input type="radio" name="best_time" value="Text me instead"><span>Text me instead</span></label>
        </div>
      </fieldset>
      <div class="field"><label for="lp-name">First name</label><input id="lp-name" name="name" autocomplete="given-name" data-name-input></div>
      <div class="field"><label for="lp-phone">Phone *</label><input id="lp-phone" name="phone" type="tel" autocomplete="tel" required></div>
      <button class="btn btn--green btn--lg" type="submit">Send to Brian<svg class="ic"><use href="#i-arrow"/></svg></button>
      <p class="form__msg form__msg--ok" role="status" hidden>Got it! Brian will have your price ready when he calls.</p>
      <p class="form__msg form__msg--err" role="alert" hidden>Something went wrong. Please call or text 303-349-2368.</p>
      <p class="form__fine">We only use your number to match this with your request. No spam.</p>
    </form>
  </div>
</section>

<section class="sec lp-work" aria-label="Recent Timeless work">
  <div class="wrap">
    <div class="sec__head" data-reveal>
      <p class="kicker">Our work</p>
      <h2>Lawns and greens Brian built</h2>
      <p>Before-and-after photos from restoration jobs go here as they come in. Nothing on this page is stock.</p>
    </div>
  </div>
  <div class="strip">
    <img src="/assets/img/backyard-putting-green-from-the-street.jpg" width="1400" height="1050" alt="Backyard putting green seen from the street" loading="lazy" decoding="async">
    <img src="/assets/img/pet-turf-dog-resting-under-deck.jpg" width="1050" height="1400" alt="Dog resting on pet turf under a deck" loading="lazy" decoding="async">
    <img src="/assets/img/artificial-lawn-fenced-yard-rock-border.jpg" width="1050" height="1400" alt="Artificial lawn in a fenced yard with a rock border" loading="lazy" decoding="async">
    <img src="/assets/img/putting-green-fire-pit-stone-wall.jpg" width="1400" height="1050" alt="Putting green beside a fire pit and stone wall" loading="lazy" decoding="async">
    <img src="/assets/img/practice-nets-and-goals-on-turf.jpg" width="1050" height="1400" alt="Practice nets and goals on artificial turf" loading="lazy" decoding="async">
    <img src="/assets/img/artificial-turf-side-yard-concrete-edge.jpg" width="1400" height="1050" alt="Artificial turf side yard with a concrete edge" loading="lazy" decoding="async">
  </div>
</section>

<section class="sec">
  <div class="wrap split">
    
    <figure class="photo" data-reveal>
      <img src="/assets/img/putting-green-at-sunset-wide.jpg" width="1400" height="1050" alt="Putting green at sunset" loading="lazy" decoding="async">
      <figcaption><b>Blown clean.</b> The finish on every Timeless job.</figcaption>
    </figure>
    <div data-reveal>
      <p class="kicker">Who's calling you</p>
      <h2>Hi, I'm Brian.</h2>
      <p class="body">I've spent 13 years building and caring for artificial turf and putting greens. When I clean your turf, I clean it the way it was built: through the blades, backing and infill, not a perfume spray on top.</p>
      <p class="body">You'll get a clear price before any work starts, and I don't leave until it's blown clean.</p>
      <p class="sig">Brian, owner of TIMELESS Turf Restoration</p>
    </div>
  </div>
</section>

<section class="sec sec--cream">
  <div class="wrap">
    <div class="sec__head center" data-reveal>
      <p class="kicker">Upfront pricing</p>
      <h2>No hourly rates. No surprises.</h2>
      <p>Your exact price comes before any work starts. Here's where it starts, by size.</p>
    </div>
    <div class="sizes" data-reveal>
      <table>
        <caption>Price by turf size</caption>
        <thead><tr><th scope="col">Turf area</th><th scope="col">Essential Clean</th><th scope="col">Premium Restoration</th></tr></thead>
        <tbody>
          <tr><th scope="row">Up to 500 sq ft</th><td>$199</td><td>$299</td></tr>
          <tr><th scope="row">501–1,000 sq ft</th><td>$249</td><td>$399</td></tr>
          <tr><th scope="row">1,001–1,500 sq ft</th><td>$299</td><td>$499</td></tr>
          <tr><th scope="row">1,501–2,000 sq ft</th><td>$349</td><td>$599</td></tr>
          <tr><th scope="row">2,001–3,000 sq ft</th><td>$449</td><td>$749</td></tr>
          <tr><th scope="row">3,001–5,000 sq ft</th><td>$599</td><td>$899</td></tr>
          <tr><th scope="row">Over 5,000 sq ft</th><td colspan="2">Custom quote</td></tr>
        </tbody>
      </table>
      <p class="sizes__note">Essential Clean: debris removal, power brushing, rinse and grooming. Premium Restoration adds deep cleaning, pet-odor and antimicrobial treatment, and infill redistribution. $199 minimum per visit.</p>
    </div>
    <p class="plans__note">Want it kept clean all year? TIMELESS CARE memberships start at $89/month.</p>
  </div>
</section>

<section class="sec">
  <div class="wrap faq">
    <div class="sec__head center" data-reveal>
      <p class="kicker">Before Brian calls</p>
      <h2>Quick answers</h2>
    </div>
    <details><summary><span class="n">1</span>Is this going to be a pushy sales call?</summary><p>No. Brian asks a few questions about your turf, gives you a price, and that's it. If it's not a fit, no hard feelings.</p></details>
    <details><summary><span class="n">2</span>How much will it cost?</summary><p>It depends on size and condition. Pricing starts at $199 for yards up to 500 sq ft, and the table above shows every size. You'll get your exact price before any work starts.</p></details>
    <details><summary><span class="n">3</span>Is it safe for my kids and dog?</summary><p>Yes. We use turf-safe, pet-safe products, and your turf is ready to use as soon as it's dry.</p></details>
    <details><summary><span class="n">4</span>I missed the call. What now?</summary><p>No problem. Call or text 303-349-2368 anytime and we'll pick up where we left off.</p></details>
    <details><summary><span class="n">5</span>Where do you work?</summary><p>Our Grand Strand service area runs from Shallotte, North Carolina, to Burgess, South Carolina, along the coast and inland through Loris and Conway. That includes communities such as Myrtle Beach, North Myrtle Beach, Carolina Forest and Longs. Not sure you're covered? Just ask when Brian calls.</p></details>
  </div>
</section>

<section class="final">
  <img src="/assets/img/putting-green-landscape-lighting-at-dusk.jpg" width="1400" height="1050" alt="" loading="lazy" decoding="async">
  <div class="wrap" data-reveal>
    <p class="kicker">Questions before Brian calls?</p>
    <h2>Call or text anytime.</h2>
    <p>You'll reach a real person, not a call center.</p>
    <div class="btnrow btnrow--center">
      <a class="btn btn--green btn--lg" href="tel:+13033492368"><svg class="ic"><use href="#i-phone"/></svg>Call 303-349-2368</a>
      <a class="btn btn--outline-light btn--lg" href="sms:+13033492368?&amp;body=Hi%20Brian!%20I%20just%20asked%20for%20a%20turf%20cleaning%20quote."><svg class="ic"><use href="#i-chat"/></svg>Send a text</a>
    </div>
  </div>
</section>



<footer class="lp-foot">
  <div class="wrap"><p>© <span data-year>2026</span> TIMELESS Turf Restoration · <a href="mailto:timelessgrass@gmail.com">timelessgrass@gmail.com</a> · <a href="/">Visit our full site</a> · <a href="/privacy/">Privacy</a></p></div>
</footer>

<div class="mbar">
  <a class="btn btn--ghost" href="tel:+13033492368"><svg class="ic"><use href="#i-phone"/></svg>Call</a>
  <a class="btn btn--green" href="sms:+13033492368?&amp;body=Hi%20Brian!%20I%20just%20asked%20for%20a%20turf%20cleaning%20quote.%20Here%20are%20a%20few%20photos%20of%20my%20turf%3A"><svg class="ic"><use href="#i-chat"/></svg>Text us photos</a>
</div>

</Base>
