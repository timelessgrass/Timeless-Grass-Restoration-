---
import { clip } from '../../lib/text';
import ArticleLayout from '../../components/ArticleLayout.astro';
import { NEIGHBORHOODS, LOCAL_SERVICES, ALL_PROBLEMS, ALL_GUIDES, findService, findTown, withPhone, TIERS } from '../../data/registry';
export function getStaticPaths() { return NEIGHBORHOODS.map((a) => ({ params: { slug: a.slug }, props: { a } })); }
const { a } = Astro.props;
const T = TIERS.neighborhoods;
const town = findTown(a.town)!;
const crumbs = [{ name: 'Home', item: '/' }, { name: 'Service areas', item: '/service-areas/' }, { name: town.name, item: `/service-areas/${town.slug}/` }, { name: a.place, item: `${T.base}${a.slug}/` }];
const services = (a.services ?? []).map(findService).filter(Boolean);
const local = LOCAL_SERVICES.filter((l) => l.town === town.slug).map((l) => ({ href: `/service-areas/${town.slug}/${l.service}/`, label: `${findService(l.service)!.name} in ${town.name}` }));
const problems = (a.problems ?? []).map((s) => ALL_PROBLEMS.find((p) => p.slug === s)).filter(Boolean);
const guides = (a.guides ?? []).map((s) => ALL_GUIDES.find((g) => g.slug === s)).filter(Boolean);
const related = (a.related ?? []).map((s) => NEIGHBORHOODS.find((x) => x.slug === s)).filter(Boolean);
const more = related.length ? related : NEIGHBORHOODS.filter((n) => n.town === town.slug && n.slug !== a.slug);
const svc = services[0];
---
<ArticleLayout collapse a={a} kicker={`${town.name}, ${town.state}`} crumbs={crumbs} description={withPhone(a.description)} sources={a.sources}
  priceLine={svc?.priceLine} priceLabel={svc?.name} plan={svc?.plan === 'premium' ? 'Premium Restoration' : svc?.plan === 'essential' ? 'Essential Clean' : undefined}
  sideLinks={[
    { h: town.name, items: [{ href: `/service-areas/${town.slug}/`, label: `Turf cleaning in ${town.name}` }, ...local] },
    { h: 'Services', items: services.map((s) => ({ href: `/services/${s!.slug}/`, label: s!.name })) },
    { h: 'Related problems', items: problems.map((p) => ({ href: `/turf-problems/${p!.slug}/`, label: p!.short })) },
    { h: 'Guides', items: guides.map((g) => ({ href: `/guides/${g!.slug}/`, label: g!.short })) },
    { h: 'More neighborhoods', items: [...more.map((r) => ({ href: `${T.base}${r!.slug}/`, label: r!.place })), { href: T.base, label: 'All neighborhood guides' }] },
  ]}
  related={more.map((r) => ({ href: `${T.base}${r!.slug}/`, title: r!.h1, blurb: clip(r!.lede, 140), image: r!.image?.src }))}
  relatedH2="More neighborhood guides"
/>
