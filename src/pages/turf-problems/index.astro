---
import Base from '../../layouts/Base.astro';
import SubHero from '../../components/SubHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { PROBLEMS, CLUSTERS } from '../../data/problems';
import { brand } from '../../data/site';
const crumbs = [{ name: 'Home', item: '/' }, { name: 'Turf problems', item: '/turf-problems/' }];
const clusters = Object.keys(CLUSTERS) as (keyof typeof CLUSTERS)[];
---
<Base title="Artificial Turf Problems, Diagnosed & Fixed | TIMELESS" description={`Smells, algae, flat paths, white crust, slow greens, flies, pooling water: every common turf problem, what causes it, and what fixes it. Call ${brand.phone}.`} crumbs={crumbs}>
  <SubHero kicker="Turf problems" h1="Start with the symptom" lede="Every page here answers one question the way it gets asked on the phone: what is it, why is it happening, how to check, and what fixes it. Some of the fixes are things you can do yourself. The rest are what we do." crumbs={crumbs} />
  {clusters.map((c) => { const items = PROBLEMS.filter((p) => p.cluster === c); return items.length > 0 && <section class="sec sec--tight"><div class="wrap"><div class="sec__head" data-reveal><h2>{CLUSTERS[c]}</h2></div><div class="index">{items.map((p) => <a class="index__item" href={`/turf-problems/${p.slug}/`} data-reveal><small>{p.short}</small><h3>{p.h1}</h3><p>{p.answer.split('. ')[0]}.</p></a>)}</div></div></section>; })}
  <CtaBand h2="Not sure what you're looking at?" text="Send a photo or describe it. Brian will tell you what it is and what it costs to fix, before anyone comes out." />
</Base>
