---
/** Service card with its photo, used on the homepage and /services/. The photo is a 480/960 WebP cut of the
 *  service's image (public/assets/img/<name>-480.webp, made with cwebp from the .jpg). */
import Icon from './Icon.astro';
import { SERVICES } from '../data/services';
import { SERVICE_ICON } from '../lib/icons';
interface Props { s: (typeof SERVICES)[number]; sizes?: string }
const { s, sizes = '(max-width: 560px) 96px, (max-width: 1100px) 46vw, 240px' } = Astro.props;
const cut = (w: number) => s.image.src.replace(/\.jpg$/, `-${w}.webp`);
---
<a class="svc-card svc-card--photo" href={`/services/${s.slug}/`}>
  <span class="svc-card__img"><img src={cut(480)} srcset={`${cut(480)} 480w, ${cut(960)} 960w`} sizes={sizes} alt={s.image.alt} width="480" height="360" loading="lazy" decoding="async"></span>
  <span class="svc-card__ic"><Icon name={SERVICE_ICON[s.slug] ?? 'sparkle'} /></span>
  <h3>{s.name}</h3>
  <p>{s.short}</p>
  <span class="price-chip"><Icon name="tag" />{s.priceLine.split(' · ')[0]}</span>
</a>
