---
import Base from '../layouts/Base.astro';
import { brand } from '../data/site';
---
<Base title={`Page not found | ${brand.name}`} description="That page isn't here." robots="noindex, nofollow">
  <section class="sec"><div class="wrap prose"><p class="kicker">404</p><h1>That page isn't here.</h1><p>Try <a href="/services/">services</a>, <a href="/turf-problems/">turf problems</a>, <a href="/service-areas/">service areas</a> or <a href="/pricing/">pricing</a>, or call <a href={brand.phoneHref}>{brand.phone}</a>.</p></div></section>
</Base>
