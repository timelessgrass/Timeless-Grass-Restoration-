t-decoration:none;\">{{ifempty(1.data.email; \"Not given\")}}</a></td></tr>\n<tr style=\"\"><td class=\"lbl\" style=\"font-family:Arial,Helvetica,sans-serif;width:38%;padding:12px 18px;border-bottom:1px solid #e2e8d9;font-size:12px;font-weight:700;letter-spacing:.4px;color:#5d6c57;vertical-align:top;\">ZIP code</td><td class=\"val\" style=\"font-family:Arial,Helvetica,sans-serif;padding:12px 18px;border-bottom:1px solid #e2e8d9;font-size:15px;line-height:1.45;font-weight:700;color:#0c1809;vertical-align:top;\">{{ifempty(1.data.zip; \"not given\")}}</td></tr>\n<tr style=\"\"><td class=\"lbl\" style=\"font-family:Arial,Helvetica,sans-serif;width:38%;padding:12px 18px;border-bottom:1px solid #e2e8d9;font-size:12px;font-weight:700;letter-spacing:.4px;color:#5d6c57;vertical-align:top;\">Wants</td><td class=\"val\" style=\"font-family:Arial,Helvetica,sans-serif;padding:12px 18px;border-bottom:1px solid #e2e8d9;font-size:15px;line-height:1.45;font-weight:700;color:#0c1809;vertical-align:top;\">{{ifempty(1.data.plan; \"Not sure, recommend one\")}}</td></tr>\n<tr style=\"\"><td class=\"lbl\" style=\"font-family:Arial,Helvetica,sans-serif;width:38%;padding:12px 18px;border-bottom:1px solid #e2e8d9;font-size:12px;font-weight:700;letter-spacing:.4px;color:#5d6c57;vertical-align:top;\">Their note</td><td class=\"val\" style=\"font-family:Arial,Helvetica,sans-serif;padding:12px 18px;border-bottom:1px solid #e2e8d9;font-size:15px;line-height:1.45;font-weight:700;color:#0c1809;vertical-align:top;\"><span style=\"font-weight:400;white-space:pre-line;\">{{ifempty(1.data.message; \"No note left\")}}</span></td></tr>\n</table>\n\n</td></tr></table>\n\n</td></tr>\n<tr><td style=\"font-family:Arial,Helvetica,sans-serif;padding:16px 10px 0;font-size:12px;line-height:1.6;color:#6b7a65;text-align:center;\">Quote form on {{1.site_url}}{{1.data.page}}<br>Sent automatically by Make for TIMELESS Turf Restoration</td></tr>\n</table>\n</td></tr></table>\n</body></html>"
