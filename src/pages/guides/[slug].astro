---
import ArticleLayout from '../../components/ArticleLayout.astro';
import { ALL_GUIDES, findGuide, findService, findProblem } from '../../data/registry';
import type { Article } from '../../data/types';
import { pricing as P, money } from '../../data/site';
const PRICE_TABLE = `<div class="tbl"><table><thead><tr><th>Turf area</th><th>${P.essential.name}</th><th>${P.premium.name}</th></tr></thead><tbody>${P.rows.map((r) => r.essential ? `<tr><td>${r.size}</td><td><strong>${money(r.essential)}</strong></td><td><strong>${money(r.premium!)}</strong></td></tr>` : `<tr><td>${r.size}</td><td colspan="2">Custom quote</td></tr>`).join('')}</tbody></table></div><p>${money(P.minimum)} minimum per visit. Prices as of September 2026.</p>`;
export function getStaticPaths() { return ALL_GUIDES.map((g) => ({ params: { slug: g.slug }, props: { g } })); }
const { g } = Astro.props;
const services = g.services.map(findService).filter(Boolean);
const problems = g.problems.map(findProblem).filter(Boolean);
const related = g.related.map(findGuide).filter(Boolean);
const a: Article = { slug: g.slug, short: g.short, kind: g.kind, title: g.title, description: g.description, h1: g.h1, lede: g.lede, question: g.question, answer: g.answer, image: g.image, sections: g.slug === 'artificial-turf-cleaning-cost' ? g.sections.map((sec) => sec.h2 === 'The price table' ? { ...sec, html: sec.html + PRICE_TABLE } : sec) : g.sections, faq: g.faq, updated: g.updated };
const crumbs = [{ name: 'Home', item: '/' }, { name: 'Guides', item: '/guides/' }, { name: g.short, item: `/guides/${g.slug}/` }];
---
<ArticleLayout a={a} kicker={g.kind === 'comparison' ? 'Comparison' : 'Guide'} crumbs={crumbs} description={g.description}
  sideLinks={[
    { h: 'Services mentioned', items: services.map((s) => ({ href: `/services/${s!.slug}/`, label: s!.name })) },
    { h: 'Related problems', items: problems.map((p) => ({ href: `/turf-problems/${p!.slug}/`, label: p!.short })) },
    { h: 'More guides', items: related.map((r) => ({ href: `/guides/${r!.slug}/`, label: r!.short })) },
  ]}
  related={related.map((r) => ({ href: `/guides/${r!.slug}/`, title: r!.h1, blurb: r!.lede.slice(0, 140) + '…', image: r!.image?.src }))}
  relatedH2="More guides"
>
</ArticleLayout>
