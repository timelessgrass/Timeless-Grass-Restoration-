---
/**
 * The reading layout every article tier uses: hero (image or diagram), answer-box,
 * takeaways, table of contents, sections, "when to call" callout, sidebar, FAQ,
 * related rail, closing band. One layout so 250 pages read as one site.
 */
import Base from '../layouts/Base.astro';
import SubHero from './SubHero.astro';
import AnswerBox from './AnswerBox.astro';
import Diagram from './Diagram.astro';
import Sidebar from './Sidebar.astro';
import Faq from './Faq.astro';
import Related from './Related.astro';
import CtaBand from './CtaBand.astro';
import { brand, SITE_URL } from '../data/site';
import type { Article } from '../data/types';

interface Props {
  a: Article;
  kicker: string;
  crumbs: { name: string; item: string }[];
  description: string;
  sideLinks?: { h: string; items: { href: string; label: string }[] }[];
  related?: { href: string; title: string; blurb: string; image?: string }[];
  priceLine?: string;
  priceLabel?: string;
  plan?: string;
  /** HTML for the closing callout; defaults to a generic call-us line */
  callout?: string;
  faqH2?: string;
  relatedH2?: string;
  extraSchema?: Record<string, unknown>[];
}
const { a, kicker, crumbs, description, sideLinks = [], related = [], priceLine, priceLabel, plan, callout, faqH2 = 'Related questions', relatedH2 = 'Keep reading', extraSchema = [] } = Astro.props;
const words = (a.lede + ' ' + a.answer + ' ' + a.sections.map((s) => s.html).join(' ') + ' ' + a.faq.map((f) => f.q + f.a).join(' ')).replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(2, Math.round(words / 220));
const updated = new Date(a.updated + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const schema = [{
  '@type': 'Article', '@id': `${canonical}#article`, headline: a.h1, description, dateModified: a.updated, datePublished: a.updated,
  author: { '@type': 'Person', name: brand.owner, worksFor: { '@id': `${SITE_URL}/#business` } }, publisher: { '@id': `${SITE_URL}/#business` },
  mainEntityOfPage: { '@id': `${canonical}#webpage` }, ...(a.image ? { image: new URL(a.image.src, Astro.site).href } : {}),
}, ...extraSchema];
const defaultCallout = `<b>Need it done?</b> ${brand.name} does this across the Grand Strand, priced by square foot before we come out. <a href="/quote/">Get a free quote</a> or call ${brand.phone}.`;
---
<Base title={a.title} description={description} crumbs={crumbs} answer={{ question: a.question, answer: a.answer }} faq={a.faq} schema={schema} ogImage={a.image?.src}>
  <SubHero kicker={kicker} h1={a.h1} lede={a.lede} crumbs={crumbs} image={a.image}>
    <p class="sub-hero__meta">{minutes} min read · Updated <time datetime={a.updated}>{updated}</time> · by {brand.owner}, {brand.name}</p>
  </SubHero>
  <section class="sec">
    <div class="wrap article">
      <article class="prose">
        <AnswerBox question={a.question} answer={a.answer} />
        {a.takeaways?.length ? <div class="takeaways"><p class="takeaways__h">Key takeaways</p><ul>{a.takeaways.map((t) => <li>{t}</li>)}</ul></div> : null}
        {a.diagram && <Diagram name={a.diagram} />}
        {a.sections.length > 3 && <nav class="toc" aria-label="On this page"><p class="toc__h">On this page</p><ol>{a.sections.map((s) => <li><a href={`#${slugify(s.h2)}`}>{s.h2}</a></li>)}<li><a href="#faq">Questions</a></li></ol></nav>}
        {a.sections.map((s) => <><h2 id={slugify(s.h2)}>{s.h2}</h2><div set:html={s.html} /></>)}
        <div class="callout callout--cta" set:html={callout ?? defaultCallout} />
      </article>
      <Sidebar priceLine={priceLine} priceLabel={priceLabel} plan={plan} links={sideLinks} />
    </div>
  </section>
  <Faq faq={a.faq} h2={faqH2} />
  <Related kicker="Related" h2={relatedH2} items={related} />
  <CtaBand />
</Base>
