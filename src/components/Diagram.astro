---
/** Inline SVG diagrams. Hand-drawn, no library; labels are real text so answer engines can read them.
 *  The odor and yard-shade diagrams were removed on 2026-09-14 (overlapping labels, hard to read). */
import type { DiagramName } from '../data/types';
interface Props { name: DiagramName; caption?: string }
const { name, caption } = Astro.props;
const captions: Record<DiagramName, string> = {
  'cross-section': 'A turf system in section: fibers held up by infill, stitched into a perforated backing, over a compacted stone base that drains.',
  'green': 'Green speed is sand depth plus rolling. Thin, contaminated sand runs slow and fuzzy; full, rolled sand runs fast and true.',
};
const c = { ink: '#0c1809', green: '#2e7a0b', lime: '#8ad132', sand: '#e9d9ad', sandDark: '#cdb77c', stone: '#c9cfc1', gravel: '#a9b0a3', water: '#6fb0d8', orange: '#ff9002', cream: '#f4f6ef', muted: '#4a5a45' };
const blades = (x0: number, x1: number, y: number, h: number, step = 7, lean = 0) => Array.from({ length: Math.floor((x1 - x0) / step) }, (_, i) => { const x = x0 + i * step + (i % 2) * 2; return `M${x},${y} q${lean + (i % 3) - 1},${-h * 0.55} ${lean + (i % 2 ? 2 : -1)},${-h}`; }).join(' ');
---
<figure class="diagram">
  {name === 'cross-section' && <svg viewBox="0 0 700 300" role="img" aria-label={captions[name]}>
    <rect x="0" y="0" width="700" height="300" fill={c.cream} rx="16"/>
    <rect x="30" y="200" width="400" height="70" fill={c.gravel}/>
    {Array.from({length:57},(_,i)=><circle cx={44+(i%19)*20+(Math.floor(i/19)%2)*8} cy={212+Math.floor(i/19)*20} r={5} fill={c.stone}/>)}
    <rect x="30" y="186" width="400" height="14" fill={c.ink}/>
    {Array.from({length:13},(_,i)=><rect x={48+i*30} y="186" width="6" height="14" fill={c.cream}/>)}
    <rect x="30" y="140" width="400" height="46" fill={c.sand}/>
    {Array.from({length:120},(_,i)=><circle cx={34+(i%40)*10} cy={146+Math.floor(i/40)*15} r={2.2} fill={c.sandDark}/>)}
    <path d={blades(34,428,186,90)} stroke={c.green} stroke-width="2.4" fill="none" stroke-linecap="round"/>
    <path d={blades(36,428,186,70,9,1)} stroke={c.lime} stroke-width="1.6" fill="none" stroke-linecap="round"/>
    <path d="M110,40 v110" stroke={c.water} stroke-width="3" stroke-dasharray="6 5"/><path d="M104,150 l6,10 6,-10" fill={c.water}/>
    <path d="M110,160 v120" stroke={c.water} stroke-width="3" stroke-dasharray="6 5" opacity=".7"/><path d="M104,280 l6,10 6,-10" fill={c.water}/>
    <text x="96" y="30" font-size="13" fill={c.water} font-weight="700">rain / rinse water</text>
    <g font-size="14" fill={c.ink} font-weight="600">
      <line x1="432" y1="120" x2="470" y2="120" stroke={c.muted}/><text x="476" y="124">Fibers (blades)</text>
      <line x1="432" y1="163" x2="470" y2="163" stroke={c.muted}/><text x="476" y="167">Infill (sand) supports fibers</text>
      <line x1="432" y1="193" x2="470" y2="193" stroke={c.muted}/><text x="476" y="197">Perforated backing</text>
      <line x1="432" y1="235" x2="470" y2="235" stroke={c.muted}/><text x="476" y="239">Compacted stone base</text>
      <text x="476" y="262" font-size="12" fill={c.muted} font-weight="400">drains down and away</text>
    </g>
  </svg>}
  {name === 'green' && <svg viewBox="0 0 700 300" role="img" aria-label={captions[name]}>
    <rect x="0" y="0" width="700" height="300" fill={c.cream} rx="16"/>
    <g>
      <text x="40" y="40" font-size="14" fill={c.ink} font-weight="700">Thin, contaminated sand</text>
      <rect x="40" y="110" width="250" height="14" fill={c.ink}/>
      <rect x="40" y="92" width="250" height="18" fill={c.sandDark}/>
      {Array.from({length:30},(_,i)=><circle cx={46+i*8} cy={98+(i%2)*6} r={2.2} fill={c.muted}/>)}
      <path d={blades(42,290,92,26,6)} stroke={c.green} stroke-width="1.8" fill="none" stroke-linecap="round"/>
      <circle cx="70" cy="60" r="6" fill="#fff" stroke={c.ink}/><path d="M80,60 h60" stroke={c.orange} stroke-width="3"/><path d="M140,54 l10,6 -10,6" fill={c.orange}/>
      <text x="40" y="150" font-size="12" fill={c.muted}>slow, fuzzy, ball drifts</text>
    </g>
    <g>
      <text x="350" y="40" font-size="14" fill={c.ink} font-weight="700">Full, rolled sand</text>
      <rect x="350" y="110" width="250" height="14" fill={c.ink}/>
      <rect x="350" y="72" width="250" height="38" fill={c.sand}/>
      {Array.from({length:90},(_,i)=><circle cx={354+(i%30)*8.3} cy={78+Math.floor(i/30)*11} r={2} fill={c.sandDark}/>)}
      <path d={blades(352,600,72,10,6)} stroke={c.green} stroke-width="1.8" fill="none" stroke-linecap="round"/>
      <circle cx="380" cy="60" r="6" fill="#fff" stroke={c.ink}/><path d="M390,60 h190" stroke={c.green} stroke-width="3"/><path d="M580,54 l10,6 -10,6" fill={c.green}/>
      <text x="350" y="150" font-size="12" fill={c.muted}>fast, true, consistent</text>
    </g>
    <g font-size="13" fill={c.ink} font-weight="600">
      <text x="40" y="200">What sets speed</text>
      <text x="40" y="222" font-size="12" font-weight="400" fill={c.muted}>1. Sand depth, even across the whole green</text>
      <text x="40" y="240" font-size="12" font-weight="400" fill={c.muted}>2. Rolling, in more than one direction</text>
      <text x="40" y="258" font-size="12" font-weight="400" fill={c.muted}>3. No pollen, needles or leaf litter softening the surface</text>
      <text x="40" y="276" font-size="12" font-weight="400" fill={c.muted}>4. The turf product sets the ceiling</text>
    </g>
  </svg>}
  <figcaption>{caption ?? captions[name]}</figcaption>
</figure>
