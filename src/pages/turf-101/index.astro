---
import Icon from '../../components/Icon.astro';
import { iconFor, KIND_ICON } from '../../lib/icons';
import { teaser } from '../../lib/text';
import Base from '../../layouts/Base.astro';
import SubHero from '../../components/SubHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { EXPLAINERS, TIERS } from '../../data/registry';
import { brand } from '../../data/site';
const T = TIERS.explainers;
const crumbs = [{ name: 'Home', item: '/' }, { name: T.name, item: T.base }];
const kinds = [...new Set(EXPLAINERS.map((a) => a.kind).filter(Boolean))] as string[];
const groups = kinds.length > 1 ? kinds.map((k) => ({ k, items: EXPLAINERS.filter((a) => a.kind === k) })) : [{ k: '', items: EXPLAINERS }];
---
<Base title={`Turf 101: How Artificial Turf Works | TIMELESS`} description={`Plain-language explainers: what the layers do, where the smell lives, what infill is for, why greens roll fast, what a power broom does.`} crumbs={crumbs}>
  <SubHero cta kicker={T.name} h1="How artificial turf actually works" lede="Plain-language explainers: what the layers do, where the smell lives, what infill is for, why greens roll fast, what a power broom does." crumbs={crumbs} />
  {groups.map((g) => <section class="sec sec--tight"><div class="wrap">{g.k && <div class="sec__head" data-reveal><h2>{g.k.charAt(0).toUpperCase() + g.k.slice(1)}</h2></div>}<div class="index" data-stagger>{g.items.map((a) => <a class="index__item index__item--ic" href={`${T.base}${a.slug}/`}><span class="index__ic"><Icon name={iconFor(a.h1)} /></span><small>{a.short}</small><h3>{a.h1}</h3><p>{teaser(a.answer)}</p></a>)}</div></div></section>)}
  <CtaBand />
</Base>
